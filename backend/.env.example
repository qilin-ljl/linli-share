# Copy to .env. Never commit a real API key.
DATABASE_URL=sqlite:///./neighloop.db
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
# Optional: override the default DeepSeek image model/provider.
# If blank, vision uses DEEPSEEK_API_KEY + https://api.deepseek.com + deepseek-flash.
VISION_API_KEY=
VISION_BASE_URL=
VISION_MODEL=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
JWT_SECRET_KEY=
NEIGHLOOP_DEMO_MODE=false
NEIGHLOOP_PUBLIC_DEMO_MODE=false
ENVIRONMENT=development
